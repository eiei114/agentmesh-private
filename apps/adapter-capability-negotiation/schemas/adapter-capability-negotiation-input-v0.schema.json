{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmesh.local/schemas/adapter-capability-negotiation-input-v0.schema.json",
  "title": "Adapter Capability Negotiation Input v0",
  "description": "Tool-neutral validated request summary and declared adapter capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_summary", "adapter_manifest"],
  "properties": {
    "schema_version": { "const": "adapter-capability-negotiation-input.v0" },
    "request_summary": { "$ref": "#/$defs/request_summary" },
    "adapter_manifest": { "$ref": "#/$defs/adapter_manifest" }
  },
  "$defs": {
    "names": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "request_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request_id", "required_common_fields", "requested_adapter_capabilities"],
      "properties": {
        "schema_version": { "const": "agentmesh-request-summary.v0" },
        "request_id": { "type": "string", "minLength": 1 },
        "required_common_fields": { "$ref": "#/$defs/names" },
        "requested_adapter_capabilities": { "$ref": "#/$defs/names" }
      }
    },
    "adapter_manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_id", "capability_contract_version", "common_fields", "adapter_specific_capabilities"],
      "properties": {
        "adapter_id": { "type": "string", "minLength": 1 },
        "capability_contract_version": { "const": "agentmesh-adapter-capabilities.v0" },
        "common_fields": { "$ref": "#/$defs/names" },
        "adapter_specific_capabilities": { "$ref": "#/$defs/names" }
      }
    }
  }
}
