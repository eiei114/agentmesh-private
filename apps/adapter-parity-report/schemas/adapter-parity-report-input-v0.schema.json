{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter-parity-report-input.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "left", "right"],
  "properties": {
    "schema_version": { "const": "adapter-parity-report-input.v0" },
    "request_id": { "type": "string", "minLength": 1 },
    "canonical_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "left": { "$ref": "#/$defs/adapter_result" },
    "right": { "$ref": "#/$defs/adapter_result" }
  },
  "$defs": {
    "adapter_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "result"],
      "properties": {
        "adapter_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "result": { "type": "object" }
      }
    }
  }
}
