{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter-evidence-traceability-input.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request", "parser", "adapter", "replay"],
  "properties": {
    "schema_version": { "const": "adapter-evidence-traceability-input.v0" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_file"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "source_file": { "type": "string", "minLength": 1 },
        "source_line": { "type": "integer", "minimum": 1 }
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "output"],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "output": { "type": "object" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact", "output"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "output": { "type": "object" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "envelope"],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "envelope": { "type": "object" }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts"],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/replay_artifact" }
        }
      }
    }
  },
  "$defs": {
    "replay_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:)?[0-9A-Fa-f]{64}$"
        }
      }
    }
  }
}
