{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-runner-adapter-compact.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_version", "request_schema_version", "valid", "canonical", "local_runner_envelope", "diagnostic_model", "diagnostic_count", "diagnostics"],
  "properties": {
    "schema_version": { "const": "local-runner-adapter-compact.v0" },
    "adapter_version": { "const": "local-runner-adapter.v0" },
    "request_schema_version": { "const": "agentmesh-request.v0" },
    "valid": { "type": "boolean" },
    "canonical": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["schema_version", "request_schema_version", "field_order", "fields"],
      "properties": {
        "schema_version": { "const": "local-runner-canonical-request.v0" },
        "request_schema_version": { "const": "agentmesh-request.v0" },
        "field_order": {
          "const": ["title", "request_kind", "issue_type", "status", "project_key", "source_prd", "source_design", "source_roadmap", "blocked_by", "unblocks", "sequence_index", "sequence_total"]
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "request_kind", "issue_type", "status", "project_key", "source_prd", "source_design", "source_roadmap", "blocked_by", "unblocks", "sequence_index", "sequence_total"],
          "properties": {
            "title": { "type": ["string", "null"] },
            "request_kind": { "type": ["string", "null"] },
            "issue_type": { "type": ["string", "null"] },
            "status": { "type": ["string", "null"] },
            "project_key": { "type": ["string", "null"] },
            "source_prd": { "type": ["string", "null"] },
            "source_design": { "type": ["string", "null"] },
            "source_roadmap": { "type": ["string", "null"] },
            "blocked_by": { "type": "array", "items": { "type": "string" } },
            "unblocks": { "type": "array", "items": { "type": "string" } },
            "sequence_index": { "type": ["integer", "null"], "minimum": 0 },
            "sequence_total": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      }
    },
    "local_runner_envelope": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["schema_version", "runner", "field_order", "id", "title", "request_kind", "issue_type", "project", "state", "sources", "dependencies", "sequence", "adapter_metadata"],
      "properties": {
        "schema_version": { "const": "local-runner-envelope.v0" },
        "runner": { "const": "local-runner.v0" },
        "field_order": {
          "const": ["id", "title", "request_kind", "issue_type", "project", "state", "sources", "dependencies", "sequence", "adapter_metadata"]
        },
        "id": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "request_kind": { "type": ["string", "null"] },
        "issue_type": { "type": ["string", "null"] },
        "project": { "type": ["string", "null"] },
        "state": { "type": "string" },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request_schema_version", "prd", "design", "roadmap"],
          "properties": {
            "request_schema_version": { "const": "agentmesh-request.v0" },
            "prd": { "type": ["string", "null"] },
            "design": { "type": ["string", "null"] },
            "roadmap": { "type": ["string", "null"] }
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocked_by", "unblocks"],
          "properties": {
            "blocked_by": { "type": "array", "items": { "type": "string" } },
            "unblocks": { "type": "array", "items": { "type": "string" } }
          }
        },
        "sequence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "total"],
          "properties": {
            "index": { "type": ["integer", "null"], "minimum": 0 },
            "total": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "adapter_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "passthrough"],
          "properties": {
            "schema_version": { "const": "local-runner-adapter-metadata.v0" },
            "passthrough": { "type": "object", "additionalProperties": true }
          }
        }
      }
    },
    "diagnostic_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "severity_order", "sort_order", "rerun_policy"],
      "properties": {
        "schema_version": { "const": "local-runner-diagnostic.v0" },
        "severity_order": { "const": ["error", "warning"] },
        "sort_order": { "const": ["code", "path", "field", "message"] },
        "rerun_policy": { "type": "string" }
      }
    },
    "diagnostic_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Must equal the length of diagnostics."
    },
    "diagnostics": {
      "type": "array",
      "description": "Array length must equal diagnostic_count.",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "field", "path", "severity", "message", "expected", "rerun_action"],
      "properties": {
        "code": { "type": "string" },
        "field": { "type": "string" },
        "path": { "type": "string" },
        "severity": { "enum": ["error", "warning"] },
        "message": { "type": "string" },
        "expected": { "type": "string" },
        "rerun_action": { "const": "fix_input_and_rerun" }
      }
    }
  }
}
