{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmesh.local/schemas/public-0x-readiness-report-input-v0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "freshness", "coverage", "request_evidence", "adapter_envelopes"],
  "properties": {
    "schema_version": { "const": "public-0x-readiness-report-input.v0" },
    "generated_at": { "type": "string", "minLength": 1 },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fresh_after"],
      "properties": {
        "fresh_after": { "type": "string", "minLength": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_request_count", "required_request_kinds", "required_evidence_fields", "required_envelopes"],
      "properties": {
        "minimum_request_count": { "type": "integer", "minimum": 1 },
        "required_request_kinds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "required_evidence_fields": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "required_envelopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["adapter_id", "phase"],
            "properties": {
              "adapter_id": { "type": "string", "minLength": 1 },
              "phase": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "request_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "request_id", "adapter_id", "captured_at", "digest"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "request_id": { "type": "string", "minLength": 1 },
          "adapter_id": { "type": "string", "minLength": 1 },
          "captured_at": { "type": "string", "minLength": 1 },
          "digest": { "type": "object" }
        }
      }
    },
    "adapter_envelopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "request_id", "captured_at", "envelope"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "request_id": { "type": "string", "minLength": 1 },
          "captured_at": { "type": "string", "minLength": 1 },
          "envelope": { "type": "object" }
        }
      }
    }
  }
}
