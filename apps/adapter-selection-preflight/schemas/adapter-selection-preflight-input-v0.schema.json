{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter-selection-preflight-input.v0",
  "title": "Adapter Selection Preflight Input v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requirements", "candidates"],
  "properties": {
    "schema_version": { "const": "adapter-selection-preflight-input.v0" },
    "requirements": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } } }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/manifest" }
    }
  },
  "$defs": {
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "priority", "capabilities"],
      "properties": {
        "adapter_id": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer" },
        "capabilities": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } } } },
        "common": { "type": "object" },
        "adapter_specific": { "type": "object" }
      }
    }
  }
}
